# Public runtime identity
NEXT_PUBLIC_SITE_NAME=Topicora
NEXT_PUBLIC_SITE_TAGLINE=Useful ideas, wherever curiosity leads.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase runtime credentials (copy from `supabase status` locally or Project Settings in production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this value with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Email (optional locally; required to send contact email in production)
RESEND_API_KEY=
EMAIL_FROM=Topicora <hello@example.com>
CONTACT_TO_EMAIL=

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# Error monitoring (optional locally; recommended in production)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Vercel Cron authorization; generate at least 32 random characters
CRON_SECRET=

# One-time administrator bootstrap values used by `pnpm create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Topicora Editor

# Deployment and CLI values; not consumed by browser runtime
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
